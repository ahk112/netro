{
  "name": "nutrisnap",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "openai": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
